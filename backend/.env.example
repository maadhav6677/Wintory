# Server Config
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://wintory_user:wintory_pwd@localhost:5432/wintory_db?schema=public

# Redis Configuration (BullMQ / Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Settings
JWT_SECRET=supersecretjwtkeyforwintorydevelopment12345!
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logger Settings
LOG_LEVEL=info
